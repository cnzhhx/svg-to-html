# svg-to-html gateway
PORT=8081

# Runtime data directory: keep this location across upgrades and backups.
# Online operating settings and administrator credentials are stored beside this file.
SVG_TO_HTML_ACCESS_STATE_PATH=./workspace/gateway/access-state.json

# Legacy import only (first startup without gateway-state.json).
# Subsequent changes belong in /transformer/admin/settings, not this file.
# SVG_TO_HTML_DAILY_UPLOAD_LIMIT=5
# SVG_TO_HTML_DAILY_QUOTA_TIME_ZONE=Asia/Shanghai
# SVG_TO_HTML_ESTIMATED_TASK_MINUTES=20
# SVG_TO_HTML_SHOWCASE_JOB_IDS=
# SVG_TO_HTML_ADMIN_KEY=
SVG_TRANSFORM_CORE_URL=http://127.0.0.1:4310

# Pinned for reproducible installs. Use :latest with `pnpm core:update` to fetch updates.
SVG_TRANSFORM_CORE_IMAGE=ghcr.io/cnzhhx/svg-transform-core:0.2.1
SVG_TRANSFORM_CORE_WORKSPACE=./workspace/core
MAX_CONCURRENT_AGENTS=1
MAX_PARALLEL_MODULE_AGENTS=4

# Optional. Local development defaults to ./backend/config/model-provider.json.
# Ubuntu deployment defaults to /etc/svg-to-html/model-provider.json.
# SVG_TRANSFORM_CORE_MODEL_CONFIG=/absolute/path/to/model-provider.json
