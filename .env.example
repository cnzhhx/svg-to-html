# svg-to-html gateway
PORT=8081
SVG_TRANSFORM_CORE_URL=http://127.0.0.1:4310

# Pinned for reproducible installs. Use :latest with `pnpm core:update` to fetch updates.
SVG_TRANSFORM_CORE_IMAGE=ghcr.io/cnzhhx/svg-transform-core:0.2.1
SVG_TRANSFORM_CORE_WORKSPACE=./workspace/core
MAX_CONCURRENT_AGENTS=1
MAX_PARALLEL_MODULE_AGENTS=4

# Optional. Local development defaults to ./backend/config/model-provider.json.
# Ubuntu deployment defaults to /etc/svg-to-html/model-provider.json.
# SVG_TRANSFORM_CORE_MODEL_CONFIG=/absolute/path/to/model-provider.json
