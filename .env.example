# svg-to-html gateway
PORT=8081
SVG_TRANSFORM_CORE_URL=http://127.0.0.1:4310

# Published core Docker image. Use :0.1.0 if you want to pin the first release.
SVG_TRANSFORM_CORE_IMAGE=ghcr.io/cnzhhx/svg-transform-core:latest
SVG_TRANSFORM_CORE_MODEL_CONFIG=./backend/config/model-provider.json
SVG_TRANSFORM_CORE_WORKSPACE=./workspace/core
MAX_PARALLEL_MODULE_AGENTS=4
