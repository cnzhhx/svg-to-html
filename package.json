{
  "name": "svg-to-html-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "corepack pnpm -C frontend build && corepack pnpm -C backend run lint:types",
    "build:frontend": "corepack pnpm -C frontend build",
    "check": "corepack pnpm -C backend run lint:types",
    "core:health": "bash scripts/core-docker.sh health",
    "core:logs": "bash scripts/core-docker.sh logs",
    "core:recreate": "bash scripts/core-docker.sh recreate",
    "core:start": "bash scripts/core-docker.sh start",
    "core:status": "bash scripts/core-docker.sh status",
    "core:stop": "bash scripts/core-docker.sh stop",
    "dev": "corepack pnpm core:start && corepack pnpm --parallel --stream --filter @svg-to-html/backend --filter @svg-to-html/frontend run dev",
    "dev:frontend": "corepack pnpm -C frontend dev",
    "doctor": "corepack pnpm -C backend run doctor",
    "lint:frontend": "corepack pnpm -C frontend run lint:types",
    "lint:types": "corepack pnpm -C backend run lint:types",
    "start": "corepack pnpm core:start && corepack pnpm -C backend start"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
