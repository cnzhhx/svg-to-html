{
  "name": "svg-to-html-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.11.0"
  },
  "scripts": {
    "admin:setup-token": "pnpm -C backend exec tsx scripts/admin.ts setup",
    "admin:reset-password": "pnpm -C backend exec tsx scripts/admin.ts recovery",
    "publish:app": "node scripts/publish.mjs",
    "build": "pnpm -C frontend build && pnpm -C backend run lint:types",
    "build:frontend": "pnpm -C frontend build",
    "check": "pnpm -C backend run lint:types",
    "core:health": "bash scripts/core-docker.sh health",
    "core:logs": "bash scripts/core-docker.sh logs",
    "core:recreate": "bash scripts/core-docker.sh recreate",
    "core:start": "bash scripts/core-docker.sh start",
    "core:status": "bash scripts/core-docker.sh status",
    "core:stop": "bash scripts/core-docker.sh stop",
    "core:update": "bash scripts/core-docker.sh update",
    "dev": "bash scripts/dev.sh",
    "dev:frontend": "pnpm -C frontend dev",
    "doctor": "pnpm -C backend run doctor",
    "lint:frontend": "pnpm -C frontend run lint:types",
    "lint:types": "pnpm -C backend run lint:types",
    "test": "pnpm test:publish && pnpm -C backend test",
    "test:publish": "node --test scripts/tests/publish.test.mjs",
    "publish:toc": "node scripts/publish.mjs"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.24"
    }
  }
}
